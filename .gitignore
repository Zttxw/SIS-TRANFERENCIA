# ----------------------------------------------------
# ARCHIVOS PRIVADOS LOCALES (NO VAN AL REPO OFICIAL)
# ----------------------------------------------------
/bd/
/conclusiones/
/documentos/
*.sqlite
*.xlsx
*.pdf

# ----------------------------------------------------
# BACKEND (LARAVEL)
# ----------------------------------------------------
/backend/vendor/
/backend/node_modules/
/backend/public/build/
/backend/public/hot/
/backend/public/storage/
/backend/storage/*.key
/backend/storage/framework/cache/data/*
/backend/storage/framework/sessions/*
/backend/storage/framework/views/*
/backend/storage/logs/*.log
/backend/.env
/backend/.env.backup
/backend/.env.production
/backend/.phpunit.result.cache

# ----------------------------------------------------
# FRONTEND (REACT / VITE)
# ----------------------------------------------------
/frontend/node_modules/
/frontend/dist/
/frontend/.env.local
/frontend/.env.*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ----------------------------------------------------
# STORAGE SEGURO DE EVIDENCIAS (LOCAL)
# ----------------------------------------------------
/storage-secure/*
!/storage-secure/**/.gitkeep

# ----------------------------------------------------
# EDITORES Y SISTEMA OPERATIVO
# ----------------------------------------------------
.DS_Store
Thumbs.db
/.fleet
/.idea
/.vscode

# Claude Code local memory (no versionar)
/memory/

